{
  "name": "eures-job-crawler",
  "version": "1.0.0",
  "description": "Fast TypeScript CLI for extracting and normalizing EURES job listings using the same JSON endpoints as the EURES web application.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nencheff/eures-job-crawler.git"
  },
  "homepage": "https://github.com/Nencheff/eures-job-crawler",
  "bugs": {
    "url": "https://github.com/Nencheff/eures-job-crawler/issues"
  },
  "keywords": [
    "eures",
    "jobs",
    "crawler",
    "typescript",
    "cli",
    "http",
    "job-search",
    "europe"
  ],
  "engines": {
    "node": ">=18"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "crawl": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^22.5.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.1.0"
  }
}
